# Render server configuration.
PORT=""
NODE_ENV="production"
FIREBASE_PROJECT_ID="your-project-id"
FIRESTORE_DATABASE_ID="(default)"
# JSON brut ou base64 ; cette valeur est secrète.
FIREBASE_SERVICE_ACCOUNT=""
SUPER_ADMIN_EMAILS=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
APP_NAME="Phone Clinic"
# Vide = même origine uniquement ; sinon indiquez l'origine exacte du front.
ALLOWED_ORIGIN=""

# Firebase Web SDK configuration (client values; restrict the API key by HTTP referrer).
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"

# Optional: use (default) unless a named Firestore database was created.
VITE_FIRESTORE_DATABASE_ID="(default)"

# Public account creation is disabled unless explicitly enabled.
VITE_ALLOW_SELF_SIGNUP="false"

# Optional absolute API base, e.g. https://service.onrender.com or https://service.onrender.com/api.
# Leave blank when the API is served on the same origin or proxied through Netlify.
VITE_API_URL=""

# Optional customer branding.
VITE_APP_NAME="Phone Clinic"
VITE_APP_SHORT_NAME="Phone Clinic"
VITE_APP_TAGLINE="Caisse & Réparation"
VITE_APP_PRIMARY_COLOR="#4f46e5"
VITE_APP_LOGO="/icon.svg"
